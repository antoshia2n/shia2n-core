{
  "manifest_version": 3,
  "name": "シアニンパネル",
  "description": "シアニンのアプリを 1 つのサイドパネルで切り替えて使う。細い画面が無いアプリは新しいタブで開く",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "シアニンパネル", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "permissions": ["sidePanel", "storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"]
}
